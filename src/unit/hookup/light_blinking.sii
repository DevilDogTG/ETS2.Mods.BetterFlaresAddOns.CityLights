SiiNunit
{

/* 	# Blink Model with background source
flare_blink : flare.model.arrow.xxxx 
{
dir_type: all

	blink_pattern: "---X-"
	blink_step_length: 0.5 # Time per step (s)
	
	state_change_duration: 0.1 # Transition time (s)

	model: "/model/flare/bf_r3.pmd" # Flare Model
	model_light_source: "/model/flare/sign_flare_red_arrow.pmd" # Background model which wont rotate or change size
}
*/


## GREEN

flare_blink : flare.model.green.blink
{
	dir_type: all

	blink_pattern: "X--"
	blink_step_length: 0.5

	model: "/model/flare/bf_gr.pmd"
	default_scale: 1.5
	scale_factor: 2.5
	scaling_start_distance: 0
	scaling_end_distance: 80
}

flare_blink : flare.model.green.blink0
{
	dir_type: all

	blink_pattern: "X--"
	blink_step_length: 0.5

	model: "/model/flare/bf_gr.pmd"
	default_scale: 1.5
	scale_factor: 2.5
	scaling_start_distance: 0
	scaling_end_distance: 80
}

flare_blink : flare.model.green.blink1
{
	dir_type: all

	blink_pattern: "-X-"
	blink_step_length: 0.5

	model: "/model/flare/bf_gr.pmd"
	default_scale: 1.5
	scale_factor: 2.5
	scaling_start_distance: 0
	scaling_end_distance: 80
}

flare_blink : flare.model.green.blink2
{
	dir_type: all

	blink_pattern: "--X"
	blink_step_length: 0.5

	model: "/model/flare/bf_gr.pmd"
}

flare : flare.model.green.noblink
{
	dir_type: all
	model: "/model/flare/bf_gr.pmd"
	default_scale: 1.5
	scale_factor: 2.5
	scaling_start_distance: 0
	scaling_end_distance: 80
}

flare : flare.model.green.nob_n
{
	dir_type: angle
	flare_inner_angle: 75.0
	flare_outer_angle: 105.0
	
	model: "/model/flare/tr_green.pmd"
	default_scale: 1.5
	scale_factor: 2.5
	scaling_start_distance: 0
	scaling_end_distance: 80
}

## ORANGE

flare_blink : flare.model.orange.blink
{
	dir_type: wide
	
	setup: lumen_hue_saturation
	ambient_color: (0, 0, 100)
	diffuse_color: (80, 32, 100)
	specular_color: (80, 32, 100)
	type: spot
	range: 6.0
	
	inner_angle: 5.0
	outer_angle: 90.0
	pitch_offset: -10
	forward_distance: false
	
	fade_distance: 120
	fade_span: 60
	
	state_change_duration: 0.01
	
	blink_pattern: "X--"
	blink_step_length: 0.5

	model: "/model/flare/bf_o1.pmd"
	default_scale: 1.5
	scale_factor: 2.5
	scaling_start_distance: 0
	scaling_end_distance: 80	
}

flare_blink_sync : flare.model.orange.blink.sync
{
	dir_type: wide
	
	setup: lumen_hue_saturation
	ambient_color: (0, 0, 100)
	diffuse_color: (80, 32, 100)
	specular_color: (80, 32, 100)
	type: spot
	range: 6.0
	
	inner_angle: 5.0
	outer_angle: 90.0
	pitch_offset: -10
	forward_distance: false
	
	fade_distance: 120
	fade_span: 60
	
	state_change_duration: 0.01
	
	blink_pattern: "X--"
	blink_step_length: 0.5

	sync_ms_delay: 100
	
	model: "/model/flare/bf_o1.pmd"
	default_scale: 1.5
	scale_factor: 2.5
	scaling_start_distance: 0
	scaling_end_distance: 80
}

